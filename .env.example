# Copy to .env for local development. Never commit real secrets.
DATABASE_URL="postgresql://bison:bison@localhost:5432/bison?schema=public&connect_timeout=20&pool_timeout=20&connection_limit=20"
# Isolated database for automated tests. Never point this at production.
TEST_DATABASE_URL="postgresql://bison:bison@localhost:5432/bison_test?schema=public&connect_timeout=20&pool_timeout=20&connection_limit=20"
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Staff bootstrap for scripts/create-admin.ts (dev only, 12+ chars).
# Production: supply one-off via the hosting provider's secret store.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Email delivery (Phase 12). When both are set the Resend adapter sends;
# otherwise development logs to the console and production records FAILED
# rows with a clear reason instead of breaking bookings/payments.
RESEND_API_KEY=""
RESEND_FROM=""

# Webhook signing for the mock payment provider (Phase 7). Optional in
# development; REQUIRED in production — the server refuses mock webhook
# verification without it. Generate with: openssl rand -hex 32
MOCK_PROVIDER_SECRET=""

# Supplier payout-detail encryption, AES-256-GCM (marketplace Phase 2).
# REQUIRED wherever suppliers are created/updated with payout details.
# Generate with: openssl rand -hex 32. Rotate by re-encrypting stored rows.
SUPPLIER_PII_KEY=""
