// Phase 3: structured safari catalogue + auth foundation.
// Booking, pricing snapshots and operations entities land in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Access control foundation (full RBAC matrices land with operations, Phase 10)
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  CONTENT_MANAGER
  SAFARI_CONSULTANT
  RESERVATION_STAFF
  OPERATIONS_MANAGER
  FINANCE_USER
  CUSTOMER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  bookings     Booking[]

  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Destination {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  country        String
  excerpt        String
  highlights     String[]      @default([])
  published      Boolean       @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tours      TourProduct[] @relation("TourDestinations")
  fees       PriceComponent[]

  @@index([published])
}

model TourCategory {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  createdAt DateTime      @default(now())
  tours     TourProduct[]
}

model TourProduct {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  categoryId    String
  category      TourCategory   @relation(fields: [categoryId], references: [id])
  destinations  Destination[]  @relation("TourDestinations")
  durationDays  Int
  excerpt       String
  overview      String[]       @default([])
  includes      String[]       @default([])
  excludes      String[]       @default([])
  published     Boolean        @default(false)
  seoTitle       String?
  seoDescription String?
  sourceUrl     String?
  sourceUpdated DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  days          ItineraryDay[]
  addOns        TourAddOn[]    @relation("TourAddOns")
  quotes        Quote[]
  bookings      Booking[]

  @@index([categoryId, published])
  @@index([published, updatedAt])
}

model ItineraryDay {
  id          String      @id @default(cuid())
  tourId      String
  tour        TourProduct @relation(fields: [tourId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String
  body        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tourId, dayNumber])
  @@index([tourId, dayNumber])
}

model Activity {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  destination  String?
  duration     String?
  priceCents   Int?
  currency     String      @default("USD")
  capacity     Int?
  published    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([published])
}

model Accommodation {
  id        String                  @id @default(cuid())
  slug      String                  @unique
  name      String
  location  String?
  category  String?
  boardBasis String?
  supplier  String?
  status    String                  @default("active")
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  roomTypes AccommodationRoomType[]
}

model AccommodationRoomType {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  name            String
  capacity        Int?
  priceCents      Int?
  currency        String        @default("USD")

  @@unique([accommodationId, name])
}

model TourAddOn {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  priceCents  Int?
  currency    String        @default("USD")
  published   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tours       TourProduct[] @relation("TourAddOns")
}

model Season {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  startsOn       String?
  endsOn         String?
  notes          String?
  // Seasonal price adjustment in basis points (10000 = no change).
  multiplierBps  Int      @default(10000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PriceComponent {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  kind          String
  amountCents   Int
  currency      String       @default("USD")
  perPerson     Boolean      @default(true)
  placeholder   Boolean      @default(false)
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id])
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([kind])
}

// Per-person-per-day base rates by comfort tier (and optional transport).
// Seeded amounts are ILLUSTRATIVE placeholders until the business sets real
// rates; quotes computed from placeholder rates are flagged as indicative.
model RateCard {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  comfortTier    String
  transportStyle String?
  amountCents    Int
  currency       String   @default("USD")
  placeholder    Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([comfortTier, transportStyle])
  @@index([comfortTier])
}

// Currency rates against the base currency (units of currency per 1 base).
// Example: base USD, KES rate 129.00 => 1 USD = 129 KES.
model CurrencyRate {
  id         String   @id @default(cuid())
  currency   String   @unique
  rateToBase Decimal  @db.Decimal(18, 6)
  asOf       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  kind          String
  amountCents   Int?
  percentBps    Int?
  currency      String    @default("USD")
  validFrom     DateTime?
  validUntil    DateTime?
  maxUses       Int?
  usedCount     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CONVERTED
}

model Quote {
  id              String      @id @default(cuid())
  number          String      @unique
  tourId          String?
  tour            TourProduct? @relation(fields: [tourId], references: [id])
  customerName    String?
  customerEmail   String?
  currency        String      @default("USD")
  status          QuoteStatus @default(DRAFT)
  validUntil      DateTime
  subtotalCents   Int
  discountCents   Int         @default(0)
  totalCents      Int
  depositCents    Int
  hasPlaceholderRates Boolean  @default(false)
  // Immutable commercial snapshot (inputs, rates, lines, totals, engine).
  snapshot        Json
  notes           String?
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           QuoteItem[]
  booking         Booking?

  @@index([status])
  @@index([tourId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  kind        String
  label       String
  quantity    Int
  unitCents   Int
  totalCents  Int
  metadata    Json?

  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// Reservations (Phase 6). Capacity masters (vehicles, properties) land in
// Phase 10; holds already carry capacity-agnostic overlap protection.
// ---------------------------------------------------------------------------

enum BookingStatus {
  INQUIRY
  QUOTE_DRAFT
  QUOTE_SENT
  HOLD
  AWAITING_DEPOSIT
  CONFIRMED
  PRE_TRIP
  ON_SAFARI
  COMPLETED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum HoldStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  customerName   String
  customerEmail  String
  customerPhone  String?
  tourId         String?
  tour           TourProduct?  @relation(fields: [tourId], references: [id])
  quoteId        String?       @unique
  quote          Quote?        @relation(fields: [quoteId], references: [id])
  status         BookingStatus @default(INQUIRY)
  currency       String        @default("USD")
  subtotalCents  Int           @default(0)
  discountCents  Int           @default(0)
  totalCents     Int           @default(0)
  depositCents   Int           @default(0)
  paidCents      Int           @default(0)
  travelStart    DateTime?
  travelEnd      DateTime?
  adults         Int           @default(1)
  children       Int           @default(0)
  infants        Int           @default(0)
  // Commercial snapshot copied from the quote (or staff-entered terms).
  snapshot       Json?
  idempotencyKey String?       @unique
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  travellers     BookingTraveller[]
  holds          Hold[]
  history        BookingStatusHistory[]
  payments       Payment[]
  messages       CustomerMessage[]
  documents      Document[]
  group          Group?
  vehicleAssignments VehicleAssignment[]
  guideAssignments   GuideAssignment[]
  transfers      Transfer[]
  notes          InternalNote[]
  invoices       Invoice[]

  @@index([status])
  @@index([customerEmail])
  @@index([tourId])
}

model BookingTraveller {
  id               String    @id @default(cuid())
  bookingId        String
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fullName         String
  kind             String    @default("adult")
  email            String?
  dateOfBirth      DateTime?
  nationality      String?
  passportNumber   String?
  passportExpiry   DateTime?
  emergencyContact String?
  dietaryNotes     String?
  medicalNotes     String?
  roomPreference   String?
  // Group travel: which invitation created this record, and which account
  // claimed it (both nullable — walk-ins and staff entries have neither).
  inviteId         String?
  invite           GroupInvite? @relation(fields: [inviteId], references: [id])
  userId           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([bookingId])
  @@index([inviteId])
}

// Group travel (Phase 9). One group per booking; the booking owner is the
// group organiser. Travellers join via single-use invitation tokens and can
// only ever see their own record.
model Group {
  id                 String        @id @default(cuid())
  bookingId          String        @unique
  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name               String
  expectedTravellers Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  invites            GroupInvite[]
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model GroupInvite {
  id         String            @id @default(cuid())
  groupId    String
  group      Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email      String?
  token      String            @unique
  status     GroupInviteStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  acceptedAt DateTime?
  travellers BookingTraveller[]

  @@index([groupId, status])
}

// Customer ↔ staff thread scoped to one booking. Staff-only internal notes
// land with operations (Phase 10); everything here is visible to the owner.
model CustomerMessage {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String?
  authorRole String  @default("customer")
  body      String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

// Staff-attached files and generated travel documents. Generated items
// (confirmation, itinerary, receipts) are rendered on demand and listed
// alongside uploads without storing duplicates.
model Document {
  id        String   @id @default(cuid())
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String?
  kind      String
  title     String
  url       String?
  body      String?
  createdById String?
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([userId])
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  from      BookingStatus?
  to        BookingStatus
  actorId   String?
  reason    String?
  createdAt DateTime      @default(now())

  @@index([bookingId, createdAt])
}

model Hold {
  id           String     @id @default(cuid())
  bookingId    String
  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resourceType String
  resourceId   String
  quantity     Int        @default(1)
  startsAt     DateTime
  endsAt       DateTime
  expiresAt    DateTime
  status       HoldStatus @default(ACTIVE)
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([resourceType, resourceId, status])
  @@index([bookingId])
  @@index([expiresAt, status])
}

// ---------------------------------------------------------------------------
// Payments (Phase 7). Raw card data is NEVER stored; only provider refs.
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  FULL
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider       String        @default("mock")
  providerRef    String?       @unique
  amountCents    Int
  currency       String        @default("USD")
  kind           PaymentKind   @default(DEPOSIT)
  status         PaymentStatus @default(PENDING)
  idempotencyKey String?       @unique
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  attempts       PaymentAttempt[]
  refunds        Refund[]

  @@index([bookingId, status])
}

model PaymentAttempt {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status    String
  providerRef String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([paymentId])
}

model Refund {
  id             String       @id @default(cuid())
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bookingId      String
  amountCents    Int
  currency       String       @default("USD")
  status         RefundStatus @default(PENDING)
  providerRef    String?      @unique
  reason         String?
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(now())

  @@index([paymentId])
  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// Operations (Phase 10): fleet, crew, transfers, notes, invoices.
// ---------------------------------------------------------------------------

model Vehicle {
  id           String   @id @default(cuid())
  registration String   @unique
  type         String
  capacity     Int
  status       String   @default("active")
  operator     String?
  location     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignments  VehicleAssignment[]
  transfers    Transfer[]

  @@index([status])
}

model VehicleAssignment {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  createdById String?
  createdAt DateTime @default(now())

  @@index([vehicleId, startsAt, endsAt])
  @@index([bookingId])
}

model Guide {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  languages      String[] @default([])
  specialisations String[] @default([])
  status         String   @default("active")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignments    GuideAssignment[]
  transfers      Transfer[]

  @@index([status])
}

model GuideAssignment {
  id        String   @id @default(cuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  createdById String?
  createdAt DateTime @default(now())

  @@index([guideId, startsAt, endsAt])
  @@index([bookingId])
}

model Transfer {
  id          String    @id @default(cuid())
  bookingId   String?
  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pickup      String
  dropoff     String
  scheduledAt DateTime
  passengers  Int       @default(1)
  vehicleId   String?
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  guideId     String?
  guide       Guide?    @relation(fields: [guideId], references: [id])
  status      String    @default("scheduled")
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scheduledAt, status])
  @@index([bookingId])
}

// Staff-only internal notes. Never exposed to customers.
model InternalNote {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  currency      String        @default("USD")
  subtotalCents Int
  discountCents Int           @default(0)
  totalCents    Int
  status        InvoiceStatus @default(DRAFT)
  snapshot      Json?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]

  @@index([bookingId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label       String
  quantity    Int
  unitCents   Int
  totalCents  Int

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Content management (Phase 11)
// ---------------------------------------------------------------------------

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String
  paragraphs     String[]      @default([])
  author         String?
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  scheduledFor   DateTime?
  category       String?
  tags           String[]      @default([])
  seoTitle       String?
  seoDescription String?
  sourceUrl      String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

// Media registry (Phase 11). URL-based records with attribution; binary
// uploads behind a storage abstraction land in a later phase.
model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  alt       String
  caption   String?
  credit    String?
  width     Int?
  height    Int?
  kind      String   @default("image")
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

// ---------------------------------------------------------------------------
// Marketplace suppliers (Phase 2). ABCT owns no fleet and no guides: every
// service is fulfilled by a third-party supplier locked per booking.
// ---------------------------------------------------------------------------

enum SupplierStatus {
  ACTIVE
  PAUSED
  BLACKLISTED
}

// Admin-managed supplier categories (airport pickup/transfer, hotel/lodge,
// driver-guide, vehicle hire, park/activity operator, flights, other...).
model SupplierType {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  suppliers Supplier[] @relation("SupplierTypes")
}

model Supplier {
  id              String         @id @default(cuid())
  name            String
  contactPerson   String?
  phone           String?
  whatsapp        String?
  email           String?
  coverageAreas   String[]       @default([])
  status          SupplierStatus @default(ACTIVE)
  rating          Int?
  notes           String?
  paymentTerms    String?
  // Bank/M-Pesa details, AES-256-GCM encrypted. Never returned by list/get;
  // reveal only through revealSupplierPayout (finance roles only).
  payoutCiphertext String?
  // Safe display hint, e.g. "M-Pesa •••• 432".
  payoutHint      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  types           SupplierType[] @relation("SupplierTypes")
  rates           SupplierRate[]
  locks           SupplierLock[]
  documents       SupplierDocument[]
  payouts         SupplierPayout[]

  @@index([status])
  @@index([name])
}

model SupplierDocument {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  kind       String
  title      String
  url        String?
  createdAt  DateTime @default(now())

  @@index([supplierId])
}

enum RateUnit {
  PER_VEHICLE_PER_DAY
  PER_PERSON_PER_NIGHT
  PER_TRANSFER
  PER_ACTIVITY
  PER_GROUP
}

model SupplierRate {
  id           String    @id @default(cuid())
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  // Stable key per supplier service; new prices create a new version row.
  serviceSlug  String
  serviceName  String
  // SupplierType slug (denormalized for filtering without a join).
  serviceType  String
  unit         RateUnit
  currency     String    @default("USD")
  costCents    Int
  season       String?
  seasonStart  String?
  seasonEnd    String?
  // Pax or vehicles this rate covers per unit of quantity.
  capacity     Int?
  validFrom    DateTime?
  validTo      DateTime?
  version      Int       @default(1)
  supersedesId String?
  supersedes   SupplierRate?  @relation("RateVersions", fields: [supersedesId], references: [id])
  supersededBy SupplierRate[] @relation("RateVersions")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  locks        SupplierLock[]

  @@unique([supplierId, serviceSlug, version])
  @@index([supplierId, serviceSlug])
  @@index([serviceType])
}

enum SupplierLockStatus {
  REQUESTED
  HELD
  CONFIRMED
  DECLINED
  RELEASED
  COMPLETED
}

model SupplierLock {
  id         String             @id @default(cuid())
  supplierId String
  supplier   Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  // Pinned rate version: confirmed bookings keep the costed rate even when
  // the card changes later.
  rateId     String?
  rate       SupplierRate?      @relation(fields: [rateId], references: [id])
  // Loose booking linkage until ServiceLine FKs land (Phase 6).
  bookingRef String?
  serviceRef String?
  serviceName String
  serviceType String
  startsAt   DateTime
  endsAt     DateTime
  quantity   Int                @default(1)
  status     SupplierLockStatus @default(REQUESTED)
  notes      String?
  createdById String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tokens     SupplierToken[]

  @@index([supplierId, status])
  @@index([supplierId, startsAt, endsAt])
  @@index([bookingRef])
}

model SupplierToken {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  supplierId String
  lockId     String?
  lock       SupplierLock? @relation(fields: [lockId], references: [id], onDelete: Cascade)
  purpose    String
  expiresAt  DateTime
  usedAt     DateTime?
  createdById String?
  createdAt  DateTime     @default(now())

  @@index([lockId])
  @@index([expiresAt])
}

enum PayoutStatus {
  DUE
  PAID
  CANCELLED
}

model SupplierPayout {
  id         String       @id @default(cuid())
  supplierId String
  supplier   Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  bookingRef String?
  lockId     String?
  amountCents Int
  currency   String       @default("USD")
  status     PayoutStatus @default(DUE)
  dueDate    DateTime?
  paidAt     DateTime?
  reference  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([supplierId, status])
  @@index([bookingRef])
}

// ---------------------------------------------------------------------------
// Notifications (Phase 12). The log is the outbox: every dispatch attempt
// is recorded; duplicates collapse on dedupeKey.
// ---------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  IN_APP
  WHATSAPP
  SMS
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model Notification {
  id          String              @id @default(cuid())
  event       String
  channel     NotificationChannel
  status      NotificationStatus  @default(QUEUED)
  toAddress   String?
  userId      String?
  bookingId   String?
  subject     String?
  body        String?
  providerRef String?
  error       String?
  dedupeKey   String?             @unique
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([bookingId])
  @@index([event, status])
}

// ---------------------------------------------------------------------------
// Settings, inquiries, audit
// ---------------------------------------------------------------------------

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ContactInquiry {
  id               String   @id @default(cuid())
  reference        String   @unique
  name             String
  email            String
  phone            String?
  country          String?
  destination      String?
  travelDates      String?
  travellers       String?
  tourSlug         String?
  message          String
  preferredContact String?
  metadata         Json?
  status           String   @default("new")
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  resource   String
  resourceId String?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Marketplace booking references (Phase 1). One row per Nairobi calendar
// day; the counter resets daily (NNN restarts at 001). Rows are created and
// incremented inside the booking transaction under an advisory lock, so two
// simultaneous submissions can never receive the same reference.
// ---------------------------------------------------------------------------

model BookingDailyCounter {
  // Nairobi calendar date as YYYY-MM-DD (Africa/Nairobi, not UTC).
  date      String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}
