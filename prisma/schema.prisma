// Phase 3: structured safari catalogue + auth foundation.
// Booking, pricing snapshots and operations entities land in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Access control foundation (full RBAC matrices land with operations, Phase 10)
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  CONTENT_MANAGER
  SAFARI_CONSULTANT
  RESERVATION_STAFF
  OPERATIONS_MANAGER
  FINANCE_USER
  CUSTOMER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  bookings     Booking[]

  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Destination {
  id         String        @id @default(cuid())
  slug       String        @unique
  name       String
  country    String
  excerpt    String
  highlights String[]      @default([])
  published  Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tours      TourProduct[] @relation("TourDestinations")
  fees       PriceComponent[]

  @@index([published])
}

model TourCategory {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  createdAt DateTime      @default(now())
  tours     TourProduct[]
}

model TourProduct {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  categoryId    String
  category      TourCategory   @relation(fields: [categoryId], references: [id])
  destinations  Destination[]  @relation("TourDestinations")
  durationDays  Int
  excerpt       String
  overview      String[]       @default([])
  includes      String[]       @default([])
  excludes      String[]       @default([])
  published     Boolean        @default(false)
  sourceUrl     String?
  sourceUpdated DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  days          ItineraryDay[]
  addOns        TourAddOn[]    @relation("TourAddOns")
  quotes        Quote[]
  bookings      Booking[]

  @@index([categoryId, published])
  @@index([published, updatedAt])
}

model ItineraryDay {
  id          String      @id @default(cuid())
  tourId      String
  tour        TourProduct @relation(fields: [tourId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String
  body        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tourId, dayNumber])
  @@index([tourId, dayNumber])
}

model Activity {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  destination  String?
  duration     String?
  priceCents   Int?
  currency     String      @default("USD")
  capacity     Int?
  published    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([published])
}

model Accommodation {
  id        String                  @id @default(cuid())
  slug      String                  @unique
  name      String
  location  String?
  category  String?
  boardBasis String?
  supplier  String?
  status    String                  @default("active")
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  roomTypes AccommodationRoomType[]
}

model AccommodationRoomType {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  name            String
  capacity        Int?
  priceCents      Int?
  currency        String        @default("USD")

  @@unique([accommodationId, name])
}

model TourAddOn {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  priceCents  Int?
  currency    String        @default("USD")
  published   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tours       TourProduct[] @relation("TourAddOns")
}

model Season {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  startsOn       String?
  endsOn         String?
  notes          String?
  // Seasonal price adjustment in basis points (10000 = no change).
  multiplierBps  Int      @default(10000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PriceComponent {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  kind          String
  amountCents   Int
  currency      String       @default("USD")
  perPerson     Boolean      @default(true)
  placeholder   Boolean      @default(false)
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id])
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([kind])
}

// Per-person-per-day base rates by comfort tier (and optional transport).
// Seeded amounts are ILLUSTRATIVE placeholders until the business sets real
// rates; quotes computed from placeholder rates are flagged as indicative.
model RateCard {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  comfortTier    String
  transportStyle String?
  amountCents    Int
  currency       String   @default("USD")
  placeholder    Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([comfortTier, transportStyle])
  @@index([comfortTier])
}

// Currency rates against the base currency (units of currency per 1 base).
// Example: base USD, KES rate 129.00 => 1 USD = 129 KES.
model CurrencyRate {
  id         String   @id @default(cuid())
  currency   String   @unique
  rateToBase Decimal  @db.Decimal(18, 6)
  asOf       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  kind          String
  amountCents   Int?
  percentBps    Int?
  currency      String    @default("USD")
  validFrom     DateTime?
  validUntil    DateTime?
  maxUses       Int?
  usedCount     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CONVERTED
}

model Quote {
  id              String      @id @default(cuid())
  number          String      @unique
  tourId          String?
  tour            TourProduct? @relation(fields: [tourId], references: [id])
  customerName    String?
  customerEmail   String?
  currency        String      @default("USD")
  status          QuoteStatus @default(DRAFT)
  validUntil      DateTime
  subtotalCents   Int
  discountCents   Int         @default(0)
  totalCents      Int
  depositCents    Int
  hasPlaceholderRates Boolean  @default(false)
  // Immutable commercial snapshot (inputs, rates, lines, totals, engine).
  snapshot        Json
  notes           String?
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           QuoteItem[]
  booking         Booking?

  @@index([status])
  @@index([tourId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  kind        String
  label       String
  quantity    Int
  unitCents   Int
  totalCents  Int
  metadata    Json?

  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// Reservations (Phase 6). Capacity masters (vehicles, properties) land in
// Phase 10; holds already carry capacity-agnostic overlap protection.
// ---------------------------------------------------------------------------

enum BookingStatus {
  INQUIRY
  QUOTE_DRAFT
  QUOTE_SENT
  HOLD
  AWAITING_DEPOSIT
  CONFIRMED
  PRE_TRIP
  ON_SAFARI
  COMPLETED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum HoldStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  customerName   String
  customerEmail  String
  customerPhone  String?
  tourId         String?
  tour           TourProduct?  @relation(fields: [tourId], references: [id])
  quoteId        String?       @unique
  quote          Quote?        @relation(fields: [quoteId], references: [id])
  status         BookingStatus @default(INQUIRY)
  currency       String        @default("USD")
  subtotalCents  Int           @default(0)
  discountCents  Int           @default(0)
  totalCents     Int           @default(0)
  depositCents   Int           @default(0)
  paidCents      Int           @default(0)
  travelStart    DateTime?
  travelEnd      DateTime?
  adults         Int           @default(1)
  children       Int           @default(0)
  infants        Int           @default(0)
  // Commercial snapshot copied from the quote (or staff-entered terms).
  snapshot       Json?
  idempotencyKey String?       @unique
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  travellers     BookingTraveller[]
  holds          Hold[]
  history        BookingStatusHistory[]
  payments       Payment[]

  @@index([status])
  @@index([customerEmail])
  @@index([tourId])
}

model BookingTraveller {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fullName  String
  kind      String   @default("adult")
  email     String?
  createdAt DateTime @default(now())

  @@index([bookingId])
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  from      BookingStatus?
  to        BookingStatus
  actorId   String?
  reason    String?
  createdAt DateTime      @default(now())

  @@index([bookingId, createdAt])
}

model Hold {
  id           String     @id @default(cuid())
  bookingId    String
  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resourceType String
  resourceId   String
  quantity     Int        @default(1)
  startsAt     DateTime
  endsAt       DateTime
  expiresAt    DateTime
  status       HoldStatus @default(ACTIVE)
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([resourceType, resourceId, status])
  @@index([bookingId])
  @@index([expiresAt, status])
}

// ---------------------------------------------------------------------------
// Payments (Phase 7). Raw card data is NEVER stored; only provider refs.
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  FULL
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider       String        @default("mock")
  providerRef    String?       @unique
  amountCents    Int
  currency       String        @default("USD")
  kind           PaymentKind   @default(DEPOSIT)
  status         PaymentStatus @default(PENDING)
  idempotencyKey String?       @unique
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  attempts       PaymentAttempt[]
  refunds        Refund[]

  @@index([bookingId, status])
}

model PaymentAttempt {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status    String
  providerRef String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([paymentId])
}

model Refund {
  id             String       @id @default(cuid())
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bookingId      String
  amountCents    Int
  currency       String       @default("USD")
  status         RefundStatus @default(PENDING)
  providerRef    String?      @unique
  reason         String?
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(now())

  @@index([paymentId])
  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// Settings, inquiries, audit
// ---------------------------------------------------------------------------

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ContactInquiry {
  id               String   @id @default(cuid())
  reference        String   @unique
  name             String
  email            String
  phone            String?
  country          String?
  destination      String?
  travelDates      String?
  travellers       String?
  tourSlug         String?
  message          String
  preferredContact String?
  metadata         Json?
  status           String   @default("new")
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  resource   String
  resourceId String?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([createdAt])
}
